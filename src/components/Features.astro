---
const items = [
  {
    num: '01',
    title: 'Compiles to Rust',
    body: 'Liva emits real Rust source, then cargo builds a native binary. No VM, no interpreter, no garbage collector. What you ship is what you wrote — minus the boilerplate.',
    tag: 'native',
  },
  {
    num: '02',
    title: 'Clean, predictable syntax',
    body: 'Familiar shape if you write TypeScript or Python. Type inference, one-liner arrows, string templates, point-free references, no semicolons.',
    tag: 'ergonomics',
  },
  {
    num: '03',
    title: 'Errors are values',
    body: 'No exceptions, no nil surprises. fail propagates, or fail short-circuits, or <default> heals. Every fallible call returns (value, error) — you decide what to do with both.',
    tag: 'safety',
  },
  {
    num: '04',
    title: 'Hybrid concurrency',
    body: 'async for I/O, par for CPU. task / await for fine control. Parallel-by-default collections via .par(). No coloured functions, no marathon refactors.',
    tag: 'concurrency',
  },
  {
    num: '05',
    title: 'Batteries actually included',
    body: 'HTTP server, SQLite, Regex, CSV, crypto, logging, .env config, date, random, process — built-in. 130+ functions you can call today without npm install.',
    tag: 'stdlib',
  },
  {
    num: '06',
    title: 'Self-hosted, tested, tooled',
    body: 'The compiler is written in Liva — three-generation bootstrap verified on every CI run. Jest-style tests, livac bench, livac doc, an interactive REPL, and full LSP for VS Code.',
    tag: 'meta',
  },
];
---

<section id="why" class="py-24 md:py-32 border-b hairline">
  <div class="max-w-6xl mx-auto px-6">
    <div class="flex items-baseline justify-between mb-16 flex-wrap gap-4">
      <div>
        <div class="section-num mb-3">§ 01 · principles</div>
        <h2 class="font-display text-4xl md:text-5xl leading-tight tracking-tight max-w-2xl">
          Built for people who'd rather <span class="italic font-serif">read</span> code than fight it.
        </h2>
      </div>
      <a href="#code" class="font-mono-tight text-sm link-anim text-[color:var(--color-ink-2)] hover:text-[color:var(--color-ink)] mt-2">show me code →</a>
    </div>

    <ol class="grid sm:grid-cols-2 lg:grid-cols-3 border-l border-t hairline">
      {items.map(it => (
        <li class="border-r border-b hairline p-7 group hover:bg-[color:var(--color-paper-2)] transition-colors">
          <div class="flex items-baseline justify-between mb-5">
            <span class="font-mono-tight text-[11px] text-[color:var(--color-ink-3)] tracking-wider">{it.num}</span>
            <span class="font-mono-tight text-[10px] uppercase tracking-[0.18em] text-[color:var(--color-accent)]">{it.tag}</span>
          </div>
          <h3 class="font-display text-xl mb-3 leading-snug">{it.title}</h3>
          <p class="text-[15px] leading-relaxed text-[color:var(--color-ink-2)]">{it.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
