---
import { createHighlighter } from 'shiki';
import fs from 'node:fs';
import path from 'node:path';

const grammarPath = path.join(process.cwd(), 'src/grammars/liva.tmLanguage.json');
const livaGrammar = JSON.parse(fs.readFileSync(grammarPath, 'utf-8'));
livaGrammar.name = 'liva';

const highlighter = await createHighlighter({
  themes: ['github-light'],
  langs: [livaGrammar],
});

const examples = [
  {
    label: 'types',
    title: 'Types & inference',
    code: `main() {
    // Liva infers what you don't write
    let count = 42                     // number (i32)
    let ratio: float = 3.14            // float (f64)
    let name: string = "Alice"         // explicit type
    let active = true                  // bool
    const MAX: number = 100            // immutable

    // Collections
    let scores = [90, 85, 92, 88]                   // [number]
    let user = Map { "name": "Ann", "city": "NY" }  // Map<string,string>
    let tags = Set { "rust", "liva" }               // Set<string>

    // Indexing + methods
    let top = scores[0]
    let avg = scores.reduce(0, (a, b) => a + b) / scores.length

    // String templates
    let greeting = $"hi {name}, top={top}, avg={avg}, max={MAX}"
    print(greeting)
}`,
  },
  {
    label: 'errors',
    title: 'Errors are values',
    code: `parsePort(s: string): number {
    let n, err = parseInt(s)
    if err => fail $"not a number: {s}"
    if n < 1 || n > 65535 => fail "out of range"
    return n
}

main() {
    // (value, error) on every fallible call
    let port, err = parsePort("8080")
    if err { print($"error: {err}") }

    // or <default> → heal with a fallback
    let timeout = parsePort("nope") or 3000

    // or fail "msg" → propagate with extra context
    let port2 = parsePort("443") or fail "bad port"

    // or fail → propagate the underlying error as-is
    let port3 = parsePort("22") or fail

    Log.info($"port={port}, port2={port2}, port3={port3}, timeout={timeout}")
}`,
  },
  {
    label: 'fns',
    title: 'Functions, lambdas, point-free',
    code: `// Multi-line function
square(x: number): number {
    return x * x
}

// One-liner with =>
double(x: number): number => x * 2

// Inferred return type
greet(name: string) => $"hello, {name}"

main() {
    let nums = [1, 2, 3, 4, 5]

    // Point-free: pass function by name
    let squares = nums.map(square)         // [1,4,9,16,25]

    // Inline lambda
    let evens = nums.filter(x => x % 2 == 0)

    // Composition with reduce
    let sum = nums.reduce(0, (a, b) => a + b)

    // forEach with point-free
    nums.forEach(print)
}`,
  },
  {
    label: 'enums',
    title: 'Enums & pattern matching',
    code: `// Variants can carry payloads
enum Shape {
    Circle(radius: float),
    Rectangle(width: float, height: float),
    Triangle(base: float, height: float)
}

area(s: Shape): float => switch s {
    Shape.Circle(r)        => 3.14 * r * r,
    Shape.Rectangle(w, h)  => w * h,
    Shape.Triangle(b, h)   => b * h / 2.0
}

main() {
    let shapes = [
        Shape.Circle(5.0),
        Shape.Rectangle(4.0, 6.0),
        Shape.Triangle(3.0, 8.0)
    ]

    for s in shapes => print($"area = {area(s)}")

    // switch is exhaustive: adding a new variant
    // without updating area() is a compile error (E0904).
}`,
  },
  {
    label: 'classes',
    title: 'Classes & interfaces',
    code: `// Interface — only method signatures
Printable {
    format(): string
}

// Class implementing an interface (" : Printable")
User : Printable {
    name: string
    email: string
    _createdMs: number     // _-prefix = private (no "private" keyword)

    constructor(name: string, email: string) {
        this.name = name
        this.email = email
        this._createdMs = Date.timestamp()
    }

    format(): string => $"{this.name} <{this.email}>"

    ageMs(): number => Date.timestamp() - this._createdMs
}

main() {
    let u = User("Ada", "ada@dev.io")
    print(u.format())          // Ada <ada@dev.io>
    print($"age = {u.ageMs()} ms")
}`,
  },
  {
    label: 'concur',
    title: 'Concurrency',
    code: `// CPU-bound work (deterministic for the demo)
heavyMath(n: number): number {
    let acc = 0
    for i in 0..n => acc += i
    return acc
}

main() {
    // par — CPU-bound work on a worker thread.
    // The binding awaits implicitly when the value is read.
    let sum1 = par heavyMath(10_000)
    print($"sum1 = {sum1}")

    // task — explicit handle. Kick off, do other work, then await.
    let t = task par heavyMath(20_000)
    Log.info("doing other work meanwhile…")
    let sum2 = await t
    print($"sum2 = {sum2}")
}`,
  },
  {
    label: 'http',
    title: 'HTTP server, batteries included',
    code: `main() {
    let db, err = DB.open("app.db")
    if err => fail err
    defer DB.close(db)

    let app = Server.create()

    app.get("/", (req) => Response.text("hello, world"))

    app.get("/users/:id", (req) => {
        let id = req.params.get("id")
        let rows, e = DB.query(db,
            "SELECT * FROM users WHERE id = ?", [id])
        if e => return Response.status(500).text(e)
        if rows.length == 0 => return Response.status(404).text("not found")
        return Response.json(rows[0])
    })

    app.post("/users", (req) => {
        let body = req.body
        let _, e = DB.exec(db, "INSERT INTO users (name) VALUES (?)", [body])
        if e => return Response.status(500).text(e)
        return Response.status(201).text("created")
    })

    Log.info("listening on :3000")
    app.listen(3000)
}`,
  },
  {
    label: 'tests',
    title: 'Built-in tests',
    code: `// run with:  livac test math.test.liva
// file:       math.test.liva
import { describe, test, beforeEach, afterEach, expect } from "liva/test"

square(x: number): number => x * x

clamp(x: number, lo: number, hi: number): number {
    if x < lo => return lo
    if x > hi => return hi
    return x
}

parseAge(s: string): number {
    let n, err = parseInt(s)
    if err => fail $"not a number: {s}"
    return n
}

describe("math utils", () => {
    beforeEach(() => Log.debug("setup"))
    afterEach(() => Log.debug("teardown"))

    test("square works", () => {
        expect(square(5)).toBe(25)
        expect(square(-3)).toBe(9)
    })

    test("clamp stays in range", () => {
        expect(clamp(150, 0, 100)).toBe(100)
        expect(clamp(-5, 0, 100)).toBe(0)
    })

    test("parseAge rejects garbage", () => {
        let _, err = parseAge("xyz")
        expect(err).toBeTruthy()
    })
})`,
  },
  {
    label: 'rust',
    title: 'Drop into Rust when you need to',
    code: `// Declare a crate at the top of the file (with version + features)
use rust "chrono" version "0.4"
use rust "uuid" version "1.6" features ["v4"]

main() {
    // Inline Rust block — typed expression
    let timestamp = rust {
        use chrono::Utc;
        Utc::now().format("%H:%M:%S").to_string()
    }
    print($"now: {timestamp}")

    let id = rust {
        use uuid::Uuid;
        Uuid::new_v4().to_string()
    }
    print($"id: {id}")
}`,
  },
];

const codeBlocks = examples.map(ex => ({
  ...ex,
  html: highlighter.codeToHtml(ex.code, { lang: 'liva', theme: 'github-light' }),
}));
---

<section id="code" class="py-24 md:py-32 bg-[color:var(--color-paper-2)] border-b hairline">
  <div class="max-w-6xl mx-auto px-6">
    <div class="mb-12">
      <div class="section-num mb-3">§ 02 · syntax in motion</div>
      <h2 class="font-display text-4xl md:text-5xl leading-tight tracking-tight max-w-3xl">
        Real Liva. Every snippet here compiles.
      </h2>
    </div>

    <div class="border hairline bg-[color:var(--color-paper)] overflow-hidden" data-showcase>
      <!-- Tabs row -->
      <div class="flex overflow-x-auto border-b hairline">
        {codeBlocks.map((ex, i) => (
          <button
            type="button"
            data-tab={i}
            class:list={[
              'shrink-0 px-4 py-3 font-mono-tight text-[11px] uppercase tracking-[0.15em] border-r hairline transition-colors',
              i === 0
                ? 'bg-[color:var(--color-ink)] text-[color:var(--color-paper)]'
                : 'text-[color:var(--color-ink-3)] hover:text-[color:var(--color-ink)] hover:bg-[color:var(--color-paper-2)]',
            ]}
          >
            {String(i + 1).padStart(2, '0')} · {ex.label}
          </button>
        ))}
      </div>

      <!-- Panels -->
      {codeBlocks.map((ex, i) => (
        <div data-panel={i} class:list={['p-6 md:p-8', i === 0 ? 'block' : 'hidden']}>
          <div class="flex items-baseline justify-between mb-4 flex-wrap gap-2">
            <h3 class="font-display text-2xl">{ex.title}</h3>
            <span class="font-mono-tight text-[11px] text-[color:var(--color-ink-3)]">
              example {String(i + 1).padStart(2, '0')} / {String(codeBlocks.length).padStart(2, '0')}
            </span>
          </div>
          <div class="overflow-x-auto" set:html={ex.html} />
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const root = document.querySelector('[data-showcase]');
  if (root) {
    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-tab]');
    const panels = root.querySelectorAll<HTMLDivElement>('[data-panel]');
    tabs.forEach(btn => {
      btn.addEventListener('click', () => {
        const idx = btn.dataset.tab;
        tabs.forEach(b => {
          const active = b.dataset.tab === idx;
          b.classList.toggle('bg-[color:var(--color-ink)]', active);
          b.classList.toggle('text-[color:var(--color-paper)]', active);
          b.classList.toggle('text-[color:var(--color-ink-3)]', !active);
        });
        panels.forEach(p => {
          p.classList.toggle('hidden', p.dataset.panel !== idx);
          p.classList.toggle('block', p.dataset.panel === idx);
        });
      });
    });
  }
</script>
