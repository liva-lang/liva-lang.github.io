---
const links = [
  { href: '/#why', label: 'Why' },
  { href: '/#code', label: 'Code' },
  { href: '/docs', label: 'Docs' },
  { href: '/examples', label: 'Examples' },
  { href: '/benchmarks', label: 'Bench' },
  { href: '/changelog', label: 'Changelog' },
  { href: '/roadmap', label: 'Roadmap' },
];
---

<header class="sticky top-0 z-50 backdrop-blur-md bg-[color:var(--color-paper)]/85 border-b hairline">
  <div class="max-w-6xl mx-auto px-6 h-14 flex items-center gap-8">
    <a href="/" class="flex items-center gap-2 group">
      <span class="font-mono-tight font-bold text-base tracking-tight">
        <span class="text-[color:var(--color-accent)]">~</span> liva
      </span>
      <span class="font-mono-tight text-[10px] text-[color:var(--color-ink-3)] uppercase tracking-[0.2em] hidden sm:inline">v2.3</span>
    </a>

    <nav class="hidden md:flex items-center gap-7 font-mono-tight text-[13px] text-[color:var(--color-ink-2)]">
      {links.map(l => (
        <a href={l.href} class="link-anim hover:text-[color:var(--color-ink)] transition-colors">{l.label}</a>
      ))}
    </nav>

    <div class="ml-auto flex items-center gap-2">
      <a
        href="https://github.com/liva-lang/livac"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 px-3 py-1.5 font-mono-tight text-[12px] border hairline hover:border-[color:var(--color-ink)] transition-colors"
      >
        <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
        </svg>
        <span>github</span>
      </a>
      <a
        href="/#install"
        class="hidden sm:inline-flex items-center px-3 py-1.5 font-mono-tight text-[12px] bg-[color:var(--color-ink)] text-[color:var(--color-paper)] hover:bg-[color:var(--color-accent)] transition-colors"
      >
        install →
      </a>
    </div>
  </div>
</header>
