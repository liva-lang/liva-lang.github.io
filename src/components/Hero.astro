---
import { createHighlighter } from 'shiki';
import fs from 'node:fs';
import path from 'node:path';

const grammarPath = path.join(process.cwd(), 'src/grammars/liva.tmLanguage.json');
const livaGrammar = JSON.parse(fs.readFileSync(grammarPath, 'utf-8'));
livaGrammar.name = 'liva';

const highlighter = await createHighlighter({
  themes: ['github-light'],
  langs: [livaGrammar],
});

const heroCode = `// server.liva
User { id: number; name: string }

main() {
    let db = DB.open("app.db") or fail "cannot open app.db"
    defer DB.close(db)

    let app = Server.create()

    app.get("/users/:id", (req) => {
        let id = req.params.get("id") ?? "0"
        let rows, err = DB.query(db,
            "SELECT id, name FROM users WHERE id = ?", [id])
        if err => return Response.status(500).text(err)
        if rows.length == 0 => return Response.status(404).text("not found")

        let row = rows[0]
        let user = User { id: row["id"], name: row["name"] }
        return Response.json(user)
    })

    Log.info("listening on :3000")
    app.listen(3000)
}`;

const codeHtml = highlighter.codeToHtml(heroCode, { lang: 'liva', theme: 'github-light' });
---

<section class="relative pt-20 md:pt-28 pb-20 md:pb-28 border-b hairline overflow-hidden">
  <div class="max-w-6xl mx-auto px-6">
    <!-- Eyebrow -->
    <div class="flex items-center gap-3 mb-10">
      <span class="eyebrow text-[color:var(--color-accent)]">v2.4.0</span>
      <span class="h-px w-8 bg-[color:var(--color-ink-3)]/40"></span>
      <span class="eyebrow text-[color:var(--color-ink-3)]">Null-coalescing `??` · Self-hosted · Jest tests</span>
    </div>

    <div class="grid lg:grid-cols-12 gap-10 lg:gap-14 items-start">
      <!-- Left: headline -->
      <div class="lg:col-span-7">
        <h1 class="font-display text-[3.25rem] sm:text-[4.5rem] lg:text-[5.5rem] leading-[0.95] tracking-tight">
          Modern syntax,<br />
          native binaries,<br />
          <span class="italic font-serif text-[color:var(--color-accent)]">zero runtime.</span>
        </h1>

        <p class="mt-8 max-w-xl text-lg text-[color:var(--color-ink-2)] leading-relaxed">
          Liva reads like TypeScript and runs like Rust. No garbage collector, no hidden cost — your
          code compiles down to a native binary you can <span class="font-mono-tight text-[0.95em]">cat /usr/local/bin</span>.
        </p>

        <div class="mt-10 flex flex-wrap items-center gap-4">
          <a
            href="#install"
            class="inline-flex items-center gap-2 px-5 py-3 bg-[color:var(--color-ink)] text-[color:var(--color-paper)] font-mono-tight text-sm hover:bg-[color:var(--color-accent)] transition-colors"
          >
            <span>$ curl -sSL install.liva-lang.dev | sh</span>
          </a>
          <a href="#code" class="font-mono-tight text-sm link-anim text-[color:var(--color-ink-2)] hover:text-[color:var(--color-ink)]">
            see real code →
          </a>
        </div>

        <!-- Numbers row -->
        <dl class="mt-14 grid grid-cols-3 gap-6 border-t hairline pt-8 max-w-lg">
          <div>
            <dt class="eyebrow text-[color:var(--color-ink-3)]">compiles to</dt>
            <dd class="mt-1 font-display text-2xl">Rust</dd>
          </div>
          <div>
            <dt class="eyebrow text-[color:var(--color-ink-3)]">runtime</dt>
            <dd class="mt-1 font-display text-2xl">0 <span class="text-base text-[color:var(--color-ink-3)] font-normal font-mono-tight">kb</span></dd>
          </div>
          <div>
            <dt class="eyebrow text-[color:var(--color-ink-3)]">stdlib fns</dt>
            <dd class="mt-1 font-display text-2xl">130<span class="text-[color:var(--color-accent)]">+</span></dd>
          </div>
        </dl>
      </div>

      <!-- Right: code preview -->
      <div class="lg:col-span-5">
        <div class="border hairline bg-[color:var(--color-paper-2)]">
          <div class="flex items-center justify-between px-4 py-2.5 border-b hairline">
            <div class="flex items-center gap-2 font-mono-tight text-[11px] text-[color:var(--color-ink-3)]">
              <span class="w-2 h-2 rounded-full bg-[color:var(--color-accent)]"></span>
              server.liva
            </div>
            <div class="flex items-center gap-1.5 font-mono-tight text-[10px] text-[color:var(--color-ink-3)]">
              <span>livac</span><span class="text-[color:var(--color-ink-3)]/50">·</span><span>run</span>
            </div>
          </div>
          <div class="p-4 overflow-x-auto" set:html={codeHtml} />
        </div>
        <p class="mt-3 font-mono-tight text-[11px] text-[color:var(--color-ink-3)] flex items-center gap-2">
          <span class="text-[color:var(--color-leaf)]">●</span>
          built-in HTTP server + SQLite — no dependencies
        </p>
      </div>
    </div>
  </div>
</section>
