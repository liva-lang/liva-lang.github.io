---
const cols = [
  {
    head: 'project',
    links: [
      { label: 'install', href: '/install', external: false },
      { label: 'docs', href: '/docs', external: false },
      { label: 'examples', href: '/examples', external: false },
      { label: 'benchmarks', href: '/benchmarks', external: false },
      { label: 'blog', href: '/blog', external: false },
      { label: 'changelog', href: '/changelog', external: false },
      { label: 'roadmap', href: '/roadmap', external: false },
    ],
  },
  {
    head: 'source',
    links: [
      { label: 'livac compiler', href: 'https://github.com/liva-lang/livac' },
      { label: 'vscode extension', href: 'https://github.com/liva-lang/vscode-extension' },
      { label: 'website', href: 'https://github.com/liva-lang/liva-lang.github.io' },
      { label: 'releases', href: 'https://github.com/liva-lang/livac/releases' },
      { label: 'agent skill', href: 'https://github.com/liva-lang/livac/tree/main/skills/liva-lang' },
    ],
  },
  {
    head: 'community',
    links: [
      { label: 'discussions', href: 'https://github.com/liva-lang/livac/discussions' },
      { label: 'issues', href: 'https://github.com/liva-lang/livac/issues' },
      { label: 'security', href: 'https://github.com/liva-lang/livac/security/advisories' },
      { label: 'license · MIT', href: 'https://github.com/liva-lang/livac/blob/main/LICENSE' },
    ],
  },
];
---

<footer class="border-t hairline bg-[color:var(--color-paper-2)]">
  <div class="max-w-6xl mx-auto px-6 py-16">
    <div class="grid md:grid-cols-12 gap-10">
      <!-- Brand -->
      <div class="md:col-span-4">
        <div class="font-mono-tight font-bold text-lg mb-3">
          <span class="text-[color:var(--color-accent)]">~</span> liva
          <span class="text-[color:var(--color-ink-3)] text-[11px] uppercase tracking-[0.2em] ml-1">v2.4.0</span>
        </div>
        <p class="text-[14px] text-[color:var(--color-ink-2)] leading-relaxed max-w-sm">
          A modern programming language that compiles to Rust.<br/>
          <span class="font-mono-tight text-[12px] text-[color:var(--color-ink-3)]">
            written in Liva, compiled by Liva, with love.
          </span>
        </p>
      </div>

      <!-- Link columns -->
      {cols.map(c => (
        <div class="md:col-span-2 lg:col-span-3">
          <div class="eyebrow text-[color:var(--color-ink-3)] mb-4">{c.head}</div>
          <ul class="space-y-2">
            {c.links.map(l => (
              <li>
                <a
                  href={l.href}
                  target={l.external === false ? undefined : '_blank'}
                  rel={l.external === false ? undefined : 'noopener'}
                  class="font-mono-tight text-[13px] text-[color:var(--color-ink-2)] hover:text-[color:var(--color-accent)] transition-colors link-anim"
                >
                  {l.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-12 pt-6 border-t hairline flex flex-wrap items-center justify-between gap-3 font-mono-tight text-[11px] text-[color:var(--color-ink-3)]">
      <span>© 2026 — released under MIT</span>
      <span>built with astro · self-hosted compiler · no trackers</span>
    </div>
  </div>
</footer>
