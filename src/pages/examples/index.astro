---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const REPO = 'https://github.com/liva-lang/livac/tree/main/examples';

const groups = [
  {
    title: 'Foundations',
    items: [
      { name: 'hello-world', desc: 'The shortest possible Liva program.', tags: ['basics'] },
      { name: 'calculator', desc: 'CLI calculator using switch + parseInt.', tags: ['cli', 'errors'] },
      { name: 'json-processing', desc: 'Parse and transform JSON with typed access.', tags: ['stdlib', 'json'] },
    ],
  },
  {
    title: 'Web & data',
    items: [
      { name: 'http-server', desc: 'Minimal HTTP server with routes + JSON responses.', tags: ['http'] },
      { name: 'http-api', desc: 'Read-only API over an in-memory store.', tags: ['http'] },
      { name: 'http-crud', desc: 'Full CRUD with SQLite persistence.', tags: ['http', 'db'] },
      { name: 'db-demo', desc: 'Direct `DB.open/exec/query/close` usage.', tags: ['db'] },
    ],
  },
  {
    title: 'Concurrency',
    items: [
      { name: 'concurrency', desc: '`async`, `par`, `task` patterns side by side.', tags: ['async', 'par'] },
      { name: 'parallel-search', desc: 'CPU-bound file search across cores.', tags: ['par'] },
    ],
  },
  {
    title: 'Real-world dogfooding',
    items: [
      { name: 'github-dashboard-real', desc: 'CLI that hits the GitHub REST API and renders a dashboard.', tags: ['http', 'cli'] },
      { name: 'crypto-tracker', desc: 'Live price ticker against a public API.', tags: ['http', 'cli'] },
      { name: 'dogfooding-v3', desc: 'Self-host pass that uncovered seven bugs.', tags: ['compiler'] },
    ],
  },
  {
    title: 'AI / experimental',
    items: [
      { name: 'ai/chat-server', desc: 'Async chat server using shared state.', tags: ['ai', 'http'] },
      { name: 'ai/code-search', desc: 'Embedding-based local code search prototype.', tags: ['ai'] },
    ],
  },
  {
    title: 'Tooling',
    items: [
      { name: 'tests/', desc: 'Jest-style suites and regression probes.', tags: ['tests'] },
      { name: 'benchmark/', desc: '`bench_*` fixtures used by `livac bench`.', tags: ['bench'] },
    ],
  },
];
---

<Layout title="Examples — Liva" description="A gallery of Liva programs you can compile and run.">
  <Nav />
  <main class="border-b hairline">
    <section class="py-20 md:py-28 border-b hairline">
      <div class="max-w-5xl mx-auto px-6">
        <div class="section-num mb-3">§ · examples</div>
        <h1 class="font-display text-4xl md:text-5xl leading-tight tracking-tight">
          Every example<br/>compiles + runs.
        </h1>
        <p class="mt-4 text-[color:var(--color-ink-2)] max-w-2xl">
          The gallery below is curated from
          <a
            href="https://github.com/liva-lang/livac/tree/main/examples"
            class="link-anim text-[color:var(--color-accent)]"
            target="_blank"
            rel="noopener"
          >livac/examples/</a> — every entry is built by CI on every push.
        </p>

        <div class="mt-8 bg-[color:var(--color-paper-2)] border hairline p-5 font-mono-tight text-[13px] overflow-x-auto">
          <span class="text-[color:var(--color-ink-3)]">$</span> git clone https://github.com/liva-lang/livac<br/>
          <span class="text-[color:var(--color-ink-3)]">$</span> cd livac/examples/<span class="text-[color:var(--color-accent)]">&lt;name&gt;</span><br/>
          <span class="text-[color:var(--color-ink-3)]">$</span> livac run main.liva
        </div>
      </div>
    </section>

    <section class="py-16 md:py-20">
      <div class="max-w-5xl mx-auto px-6 space-y-16">
        {groups.map(g => (
          <article>
            <h2 class="font-display text-2xl md:text-3xl tracking-tight mb-6">{g.title}</h2>
            <ul class="grid md:grid-cols-2 gap-px bg-[color:var(--color-rule)] border hairline">
              {g.items.map(it => (
                <li class="bg-[color:var(--color-paper)] p-5 hover:bg-[color:var(--color-paper-2)] transition-colors">
                  <a
                    href={`${REPO}/${it.name.split('/')[0]}`}
                    target="_blank"
                    rel="noopener"
                    class="block group"
                  >
                    <div class="flex items-baseline justify-between gap-3">
                      <span class="font-mono-tight text-[14px] text-[color:var(--color-ink)] group-hover:text-[color:var(--color-accent)] transition-colors">
                        {it.name}
                      </span>
                      <span class="font-mono-tight text-[11px] text-[color:var(--color-ink-3)]">→</span>
                    </div>
                    <p class="text-[13px] text-[color:var(--color-ink-2)] mt-1">{it.desc}</p>
                    <div class="mt-3 flex flex-wrap gap-1.5">
                      {it.tags.map(t => (
                        <span class="font-mono-tight text-[10px] uppercase tracking-[0.15em] text-[color:var(--color-ink-3)] border hairline px-1.5 py-0.5">
                          {t}
                        </span>
                      ))}
                    </div>
                  </a>
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
