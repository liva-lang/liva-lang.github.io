---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';

const releases = [
  {
    version: '2.8.14',
    date: '2026-06-04',
    title: 'Plan 6.1 — Lazy Iterator<T> (direct-form chains)',
    headline: 'Lazy `Iterator<T>` sequences compile to native Rust iterators — values are produced on demand and chained transformations run element-by-element with zero allocation until a terminal step.',
    bullets: [
      'Three sources: `Iterator.range(start, end)` (finite), `Iterator.of(array)` (wrap an array), `Iterator.generate(closure)` (infinite, via `from_fn`).',
      'Chainable lazy operators `map` / `filter` / `take` / `drop` plus terminals `toArray()`, `forEach(f)`, `reduce(init, f)`.',
      'Example: `Iterator.range(1, 100).filter((x) => x % 2 == 0).take(3).toArray()` → `[2, 4, 6]`.',
      '`Iterator<T>` return type lowers to Rust `impl Iterator<Item = T>`. Constructor is `generate` (not `from` — reserved).',
      'New doc `language-reference/stdlib/iterator.md`; e2e 62/62 green (`iterator.test.liva`); self-host gen-2 == gen-3 idempotent.',
    ],
  },
  {
    version: '2.8.13',
    date: '2026-06-04',
    title: 'Plan 3 — User-defined generics (native Rust monomorphization)',
    headline: 'Generic functions and classes compile straight to Rust-native generics — zero overhead, fully type-safe — and type parameters used as `Map`/`Set` keys automatically gain the `Eq + Hash` bounds they need.',
    bullets: [
      'Generic functions: `identity<T>`, `firstOf<T>(xs:[T]):T?`, `pairKey<T,K>`, generic callbacks `mapAll<T,K>(xs:[T], f:(T)=>K):[K]`.',
      'Generic classes: `Container<T> { value: T  get(): T => this.value }`.',
      'Auto `Eq + Hash` for Map keys enables `keyBy<T,K>(xs:[T], pick:(T)=>K): Map<K,T>` with `.set()`/`.get()`.',
      'New `collectHashableInType` + `buildTypeParamStrEx` walk params + return type and bound the right type params.',
      'New doc `language-reference/generics.md`; E2E suite green; self-host gen-2 == gen-3 idempotent.',
    ],
  },
  {
    version: '2.8.12',
    date: '2026-06-04',
    title: 'Plan 1.1 *full* MVP⁶ — Result/Option-wrapped interface returns',
    headline: 'Interface coercion now covers `Iface?` (optional) and `Iface!` (fallible) return types, completing automatic coercion in every context — no manual `Box::new` is ever required.',
    bullets: [
      'Optional returns: `pickShape(k): Describable?` wraps in `Some(Box::new(...) as Box<dyn Describable>)`; a `null` literal collapses to `None`.',
      'Fallible returns: `buildShape(k): Describable!` wraps in `Ok(Box::new(...) as Box<dyn Describable>)`.',
      'Works for free functions, block methods and arrow methods alike.',
      'New emitter state `_currentReturnInterfaceOptional`/`_currentReturnInterfaceFallible` + helper `_emitWrappedIfaceReturn`.',
      'E2E suite green with 5 new tests (optional ×3, fallible ×2); self-host gen-2 == gen-3 idempotent.',
    ],
  },
  {
    version: '2.8.11',
    date: '2026-06-04',
    title: 'Plan 1.1 *full* MVP⁴/⁵ — array & method-call interface coercion',
    headline: 'Interface coercion now extends to array-typed params `f(xs: [Iface])` and instance-method params `obj.method(iface)` (scalar and array), completing every non-Result/Option coercion context.',
    bullets: [
      'Array params: `sumAll([Box(2,3), Circle(4)])` wraps each element in `Box::new(...) as Box<dyn Measurable>` (with `&` prefix for borrowed collection params).',
      'Method-call coercion: `reporter.report(Box(3,4))` resolves the receiver class and coerces the interface argument like a free function.',
      '`_buildCallSiteParamRegistry` now walks class methods (`ClassName.methodName:idx`); new `_paramInterfaceArrayName` map + `_emitIfaceArrayArg` helper.',
      'E2E suite 61/61 green with 6 new tests (array params ×3, method-call ×3); self-host gen-2 == gen-3 idempotent.',
      'Remaining: Result/Option-wrapped interface returns (Plan 1.1 *full* tail).',
    ],
  },
  {
    version: '2.8.10',
    date: '2026-06-04',
    title: 'Plan 1.1 *full* MVP³ — call-site interface coercion (params)',
    headline: 'Free functions whose parameters are typed as an interface now auto-coerce the concrete argument at the call site: `shout(g: Greeter)` can be called directly with `shout(Bob())`, wrapping it in `Box::new(...) as Box<dyn Greeter>`.',
    bullets: [
      'Call site: `shout(Bob())` emits `shout(Box::new(Bob::new()) as Box<dyn Greeter>)`.',
      'Multiple interface-typed parameters in one signature are each coerced independently.',
      'New codegen pre-pass `_buildCallSiteParamRegistry` populates `_paramInterfaceName` (`"funcName:paramIndex" -> interfaceName`), consulted in `_emitCall`.',
      'E2E suite 61/61 green (new "Call-site Interface Coercion" tests); self-host gen-2 == gen-3 idempotent.',
      'Still pending: interface params on instance methods, `[Iface]` params, and Result/Option-wrapped interface returns (tracked in `ROADMAP_V3.md` Plan 1.1 *full*).',
    ],
  },
  {
    version: '2.8.9',
    date: '2026-06-03',
    title: 'Plan 1.1 *full* MVP² — return-type interface coercion',
    headline: 'Functions and methods returning interface-typed values now auto-coerce: `getGreeter(): Greeter` wraps the result in `Box::new(...) as Box<dyn Greeter>`, and `[Greeter]` returns wrap each element.',
    bullets: [
      'Scalar returns: `f(): Greeter => Bob()` emits `Box::new(Bob::new()) as Box<dyn Greeter>`.',
      'Array returns: `f(): [Greeter] => [Bob(), Ana()]` wraps each element with the trait-object cast.',
      'New codegen state (`_currentReturnInterface` / `_currentReturnInterfaceArray`) drives detection in functions, methods, and `return` statements.',
      'E2E suite green; self-host gen-2 == gen-3 idempotent.',
      'Still pending: Result/Option-wrapped interface returns and call-site param coercion (tracked in `ROADMAP_V3.md` Plan 1.1 *full* remaining work).',
    ],
  },
  {
    version: '2.8.8',
    date: '2026-06-03',
    title: 'Plan 1.1 *full* MVP⁺ — interface arrays',
    headline: 'Interface arrays with explicit annotation: `let xs: [Greeter] = [Bob(), Ana()]` now emits a `Vec<Box<dyn Greeter>>` with each element wrapped in `Box::new(...) as Box<dyn Greeter>`.',
    bullets: [
      'Polymorphic loop (`for x in xs { print(x.greet()) }`) dispatches through the trait.',
      'CLI suite now 26/26 (new Test 24 asserts the generated Rust + runtime output).',
      'Self-host gen-2 == gen-3 idempotent.',
      'Function parameters typed `(g: Greeter)` or `(xs: [Greeter])` still need call-site auto-`Box::new`; the type side already emits `Box<dyn Iface>` / `Vec<Box<dyn Iface>>` but callers must use the explicit `let` form for now.',
    ],
  },
  {
    version: '2.8.7',
    date: '2026-06-03',
    title: 'Plan 1.1 *full* MVP — interface-as-type in `let` bindings',
    headline: 'Interface names can now appear as a value-type in `let` annotations; the compiler emits `Box<dyn Iface>` storage and wraps the initialiser in `Box::new(...)` for the unsized coercion.',
    bullets: [
      '`let g: Greeter = Bob()` → `let mut g: Box<dyn Greeter> = Box::new(Bob::new());` with dispatch through the trait.',
      'Builds on the 2.8.4 foundation (`pub trait` + `impl Trait for Class` forwarders).',
      'CLI suite now 25/25 (new Test 23 covers the MVP path end-to-end).',
      'Parameter / return / field / array element coercion still requires an explicit `let` wrapper — tracked in `ROADMAP_V3.md` Plan 1.1 *full* (needs a `Clone` supertrait helper).',
      'Self-host gen-2 == gen-3 idempotent.',
    ],
  },
  {
    version: '2.8.6',
    date: '2026-06-03',
    title: 'Roadmap docs sweep — Plan 4 + Plan 5 closure',
    headline: 'Reference docs updated to cover concurrency timeouts/channels, HTTP per-request options, and typed JSON shortcuts; roadmap housekeeping marked the remaining N/A items honestly.',
    bullets: [
      'Concurrency reference now documents `expr timeout ms` and `Channel<T>` MPSC.',
      'HTTP reference now documents the `{ timeout, retries, backoff }` per-request options map.',
      'JSON basics reference now documents the `JSON.getString/getInt/getFloat/getBool/getArray` shortcuts.',
      'Roadmap items that are either covered by stronger ejecutable tests or blocked architecturally are marked N/A with the real reason instead of left dangling.',
      'No compiler changes; self-host gen-2 == gen-3 idempotent.',
    ],
  },
  {
    version: '2.8.5',
    date: '2026-06-03',
    title: 'Plan 2 cleanup — error codes E0205 + E0206',
    headline: 'Triple-quoted strings without a closing fence and `...` spread used outside a literal now report dedicated error codes.',
    bullets: [
      '`E0205` — lexer error pointing at the opening `"""` when EOF is reached without a matching close.',
      '`E0206` — parser error raised when `...` appears in an expression position outside an array, object, or map literal.',
      'CLI Test 22 asserts both error codes on minimal repro programs.',
    ],
  },
  {
    version: '2.8.4',
    date: '2026-06-03',
    title: 'Plan 1.1 foundation — interfaces emit traits',
    headline: 'Every Liva interface now emits a Rust `pub trait` block and every implementing class gets an `impl Trait for Class` forwarder.',
    bullets: [
      'Foundation step toward letting interface names be used as value types. The trait declarations + impl-for forwarders are useful per se (rust { } interop) and are the scaffolding for full type-as-storage support.',
      'Forwarders call the inherent method on `self` and rely on Rust\'s preference for inherent over trait methods, so no recursion.',
      'CLI Test 21 asserts the trait block, impl-for block, and runtime behaviour.',
      'Type-as-storage (Box<dyn Iface>, [Iface] params, Iface fields) remains deferred — requires a Clone supertrait helper and type-aware call coercion.',
    ],
  },
  {
    version: '2.8.3',
    date: '2026-06-03',
    title: '`livac cache` inspection and cleanup',
    headline: 'Two new subcommands let you inspect and wipe the incremental build cache.',
    bullets: [
      '`livac cache info` prints the active cache root (honouring `LIVA_CACHE_DIR`) and the number of entries.',
      '`livac cache clear` removes the cache root and every entry; no-ops cleanly when the root is absent.',
      'CLI test suite gains Test 20 covering populated → clear → empty.',
    ],
  },
  {
    version: '2.8.2',
    date: '2026-06-03',
    title: 'Incremental build cache (Plan 6.3 MVP)',
    headline: '`livac build` / `livac run` reuse a content-addressed binary cache, skipping `cargo build` when generated Rust is unchanged.',
    bullets: [
      'Cache key is the SHA-256 of (compiler version, release flag, generated `Cargo.toml`, generated `main.rs`, module files sorted by name). Input path is excluded so the same project shares entries across working directories.',
      'Cache root resolves to `$LIVA_CACHE_DIR`, else `$HOME/.cache/liva/build`, else `.liva-cache/`. Layout is `<root>/<sha256>/binary` only — no cargo target trees are duplicated.',
      'New CLI flag `--no-cache` forces a full rebuild when validating clean output or debugging toolchain issues.',
      'Hot-cache rebuild on `examples/hello-world` is ~3ms (median of 5 runs) vs ~111ms for `--no-cache` with warm cargo target — see `benchmarks/COMPILE_SPEED.md` for the methodology.',
      'CLI suite Test 19 covers cache hit, source-change invalidation, and asserts cache entries contain only the binary. Plan 4.1 (`parallel { }`) was also cancelled this cycle due to semantic overlap with the existing async spawn model.',
    ],
  },
  {
    version: '2.7.2',
    date: '2026-06-01',
    title: 'Nightly CI hotfix',
    headline: 'Chained-filter codegen regression patched; nightly green again.',
    bullets: [
      '`arr.map(...).filter(...)` no longer emits a trailing `.cloned()` when the filter input is another iterator-producing method — fixes `E0271/E0631/E0599` in the `array_pipeline` benchmark.',
      '`cargo fmt --all` sweep on the `liva-tools/` crate restores the Rustfmt gate.',
      'No language changes; pure release-engineering and codegen polish.',
    ],
  },
  {
    version: '2.7.1',
    date: '2026-05-29',
    title: 'Desktop-examples sweep',
    headline: 'Eight codegen fixes uncovered by running every homepage snippet end-to-end.',
    bullets: [
      '`livac run` / `livac build` now surface real `cargo` errors instead of silently failing.',
      'Stdlib tuple `or fail` / `or <default>`, chained `Response.status(N).text(body)`, point-free `forEach(print)`, fallible `main` Display output, defer on `DB.close` / `File.close`, err-binding `toBeTruthy()` — all fixed.',
      'All 9 snippets in the website `CodeShowcase` now build and run unmodified through `livac run` / `livac test`.',
    ],
  },
  {
    version: '2.7.0',
    date: '2026-05-28',
    title: '`livac update` ported to gen-2',
    headline: 'Self-update flow rewritten in pure Liva; `Sys.{exe,os,arch}` lands in the stdlib.',
    bullets: [
      '`Sys.exe()` / `Sys.os()` / `Sys.arch()` — portable runtime introspection.',
      '`Process.exec` and `Process.spawn` now select the host shell at runtime (`cmd /C` on Windows, `sh -c` elsewhere).',
      '`livac update` reimplemented in `compiler/src/main.liva` — queries GitHub, downloads, extracts, atomically replaces the running binary.',
      '`(self-hosted)` banner dropped from CLI tagline — it is the default now.',
    ],
  },
  {
    version: '2.6.0',
    date: '2026-05-28',
    title: 'Self-host binary on every platform',
    headline: 'gen-2 ships as the installed compiler on Linux, macOS x64/arm64, and Windows.',
    bullets: [
      'New `selfhost-source` job in `release.yml` rebuilds gen-1 → gen-2 → gen-3 and uploads the gen-2 Rust crate.',
      'Every target in the build matrix downloads that crate and cargo-builds natively; no per-OS seed binaries needed.',
      '`.deb` / `.rpm` / `.tar.gz` / `.zip` artifacts on every platform now contain the same canonical compiler that passes all 9 CI gates locally.',
    ],
  },
  {
    version: '2.5.0',
    date: '2026-05-28',
    title: 'Self-host closes the loop on Linux',
    headline: '`.deb` / `.rpm` / `.tar.gz` now ship the gen-2 binary, not the Rust bootstrap.',
    bullets: [
      'Release pipeline runs `compiler/tests/rebuild_selfhost.sh` and substitutes `target/livac-gen2-release` for the Rust bootstrap before packaging.',
      'First release where the binary inside the installer matches the one used to validate every PR.',
      'Closes the divergence behind the v2.4.1 `??` regression — every new gen-2 feature reaches users on tag.',
    ],
  },
  {
    version: '2.4.0',
    date: '2026-05-27',
    title: 'Null-coalescing operator',
    headline: '`x ?? fallback` end-to-end — lexer, parser, codegen, docs.',
    bullets: [
      'New binary operator `??` with right-associativity (chains correctly: `a ?? b ?? c`).',
      'Codegen no longer emits a spurious `.unwrap()` on collection getters when followed by `??`.',
      'New e2e selfhost fixture `app29_coalesce.liva` exercising the operator across the toolchain.',
      'Benchmarks regenerated (Liva/Rust 5-run median): worst 1.17×, best 0.44× — within the ≤1.20× target.',
      'Docs (`QUICK_REFERENCE`, `language-reference/operators.md`, `skills/liva-lang`) refreshed.',
      'VS Code extension v0.17.1: syntax highlighting + snippet `coalesce` for `??`.',
    ],
  },
  {
    version: '2.3.0',
    date: '2026-05-21',
    title: 'Tooling completion',
    headline: 'REPL, doc generator, bench runner, coverage, Jest hooks.',
    bullets: [
      '`livac repl` — interactive read-eval-print loop powered by rustyline.',
      '`livac doc` — Markdown reference generated from `///` doc-comments.',
      '`livac bench` — runs `bench_*` functions and prints one `BENCH … ms` line each.',
      '`livac test --coverage` — wraps the run with `cargo-llvm-cov` for line/branch coverage.',
      'Jest-style `beforeEach` / `afterEach` (plus `beforeAll` / `afterAll`) on `describe()` blocks.',
      'Lazy iterator chain fusion — `filter().map().take(n)` collapses to one allocation-free pipeline.',
      '`LIVA_STRICT=1` env var to tighten the codegen prelude.',
      'Bench gate in CI; reproducible bootstrap seed committed at `bootstrap/seed/livac-linux-amd64`.',
    ],
  },
  {
    version: '2.2.0',
    date: '2026-05-20',
    title: 'YAML/TOML stdlib + JSON .length fix',
    headline: 'Configuration formats land in the stdlib.',
    bullets: [
      '`YAML.parse` / `YAML.stringify` for YAML 1.2 documents.',
      '`TOML.parse` / `TOML.stringify` for the popular config format.',
      '`JSON Value.length` now matches array/object/string semantics consistently.',
    ],
  },
  {
    version: '2.1.0',
    date: '2026-05-20',
    title: 'Phase F — workspace split + self-hosted tooling',
    headline: 'Compiler crate splits cleanly between bootstrap and the canonical Liva sources.',
    bullets: [
      'Workspace cargo split: `bootstrap/` (frozen Rust gen-0) vs `compiler/` (Liva gen-2).',
      'Self-hosted `livac fmt` and `livac lint` rewritten in Liva.',
      'CLI subcommand dispatcher rewritten in Liva.',
      'Probe `tests/regression/` suite green across both crates.',
    ],
  },
  {
    version: '2.0.0',
    date: '2026-05-04',
    title: 'Self-hosting milestone',
    headline: 'gen-1 → gen-2 → gen-3 build idempotent — the compiler compiles itself end-to-end.',
    bullets: [
      'Phase 12 release gate: identical output across three self-hosted generations.',
      'Recursive enums auto-boxed by codegen (no manual indirection).',
      '`Map<K, V>` and `Set<T>` first-class with literal syntax.',
      'Error trace chaining: every fallible call carries source position.',
    ],
  },
  {
    version: '1.9.0',
    date: '2026-03-23',
    title: 'Dogfooding — full REST API on top of the language',
    headline: 'Seven bugs uncovered and squashed by writing a real CRUD service in Liva.',
    bullets: [
      'HTTP server (axum-backed): `Server.create`, `app.get/post/put/delete`, `app.listen`.',
      '`Response` helpers — `text`, `json`, `status`.',
      'SQLite-backed `DB.open/exec/query/close` (rusqlite bundled).',
      'Logging module: `Log.info/warn/error/debug` with variadic args + table renderer.',
    ],
  },
  {
    version: '1.8.0',
    date: '2026-03-23',
    title: 'DB + Linter',
    headline: 'Persistent storage and a built-in linter.',
    bullets: [
      'SQLite module with parameterized queries.',
      '`livac lint` — W001 (unused var), W002 (unused import), W003 (unreachable), W004 (always true/false).',
    ],
  },
  {
    version: '1.7.0',
    date: '2026-03-22',
    title: 'Stdlib P2 + HTTP server',
    headline: 'Random, Crypto, Process — and a real web server.',
    bullets: [
      '`Random` (5 functions), `Crypto` (4 functions), `Process` (4 functions).',
      'HTTP server module — routes, params, responses, content types.',
    ],
  },
  {
    version: '1.6.0',
    date: '2026-03-20',
    title: 'Stdlib P1',
    headline: 'File / Dir / Regex / Date / CSV.',
    bullets: [
      'File (11 functions), Dir (7), Regex (5), Date (14), CSV (8).',
    ],
  },
  {
    version: '1.5.0',
    date: '2026-03-20',
    title: 'rust { } interop + Logging + Config + `livac init`',
    headline: 'Embed Rust freely, structured logs, dotenv-style config, scaffolded projects.',
    bullets: [
      'Inline `rust { ... }` blocks compile straight through.',
      '`use rust crate@version features [...]` for dependencies.',
      '`Config.load/get/getInt/getBool/getAll` over `.env` files.',
      '`livac init` scaffolds a runnable project in one command.',
    ],
  },
];
---

<Layout title="Changelog — Liva" description="Release history for the Liva compiler.">
  <Nav />
  <main class="border-b hairline">
    <section class="py-20 md:py-28 border-b hairline">
      <div class="max-w-4xl mx-auto px-6">
        <div class="section-num mb-3">§ · changelog</div>
        <h1 class="font-display text-4xl md:text-5xl leading-tight tracking-tight">
          Every version, one screen.
        </h1>
        <p class="mt-4 text-[color:var(--color-ink-2)] max-w-2xl">
          Headline notes for each release. The full history — including dev cycles,
          bug fixes, and refactors — lives in <a
            href="https://github.com/liva-lang/livac/blob/main/CHANGELOG.md"
            class="link-anim text-[color:var(--color-accent)]"
            target="_blank"
            rel="noopener"
          >CHANGELOG.md on GitHub</a>.
        </p>
      </div>
    </section>

    <section class="py-16 md:py-20">
      <div class="max-w-4xl mx-auto px-6 space-y-12">
        {releases.map((r, i) => (
          <article class="grid md:grid-cols-12 gap-6 md:gap-10 border-b hairline pb-12 last:border-b-0">
            <header class="md:col-span-3">
              <div class="font-mono-tight text-[11px] text-[color:var(--color-ink-3)] uppercase tracking-[0.2em]">
                v{r.version}
              </div>
              <div class="font-mono-tight text-[12px] text-[color:var(--color-ink-2)] mt-1">
                {r.date}
              </div>
            </header>
            <div class="md:col-span-9">
              <h2 class="font-display text-2xl md:text-3xl tracking-tight leading-tight">
                {r.title}
              </h2>
              <p class="mt-3 text-[color:var(--color-ink-2)]">{r.headline}</p>
              <ul class="mt-5 space-y-2 text-[15px] text-[color:var(--color-ink-2)]">
                {r.bullets.map(b => (
                  <li class="flex gap-3">
                    <span class="text-[color:var(--color-accent)] font-mono-tight select-none">›</span>
                    <span set:html={b
                      .replaceAll(/`([^`]+)`/g, '<code class="font-mono-tight text-[13px] text-[color:var(--color-ink)] bg-[color:var(--color-paper-2)] px-1.5 py-0.5">$1</code>')
                    } />
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}

        <div class="pt-4 text-center font-mono-tight text-[12px] text-[color:var(--color-ink-3)]">
          everything older →
          <a
            href="https://github.com/liva-lang/livac/blob/main/CHANGELOG.md"
            class="link-anim text-[color:var(--color-accent)] ml-1"
            target="_blank"
            rel="noopener"
          >CHANGELOG.md</a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
